    return player, enemies, objects, hazards, weapon_pickup, 3, 0.0


def update_enemies(enemies, frame, dt):
    for enemy in enemies:
        enemy["hit_timer"] = max(0.0, enemy["hit_timer"] - dt)
        behavior = enemy.get("behavior", enemy["kind"])
        rect = enemy["rect"]
        rect.x += round(enemy["speed"] * frame)

        if rect.left <= enemy["left"]:
            rect.left = enemy["left"]
            enemy["speed"] = abs(enemy["speed"])
        elif rect.right >= enemy["right"]:
            rect.right = enemy["right"]
            enemy["speed"] = -abs(enemy["speed"])

        if enemy["amplitude"]:
            enemy["phase"] += dt * (6.0 if behavior == "hopper" else 3.2)
            if behavior == "hopper":
                rect.y = enemy["base_y"] - round(abs(math.sin(enemy["phase"])) * enemy["amplitude"])
            else:
                rect.y = enemy["base_y"] + round(math.sin(enemy["phase"]) * enemy["amplitude"])


def update_projectiles(enemies, projectiles, player, dt, solids, food_drops):
    for enemy in enemies:
        behavior = enemy.get("behavior", enemy["kind"])
        if behavior not in ("cave_shooter", "cave_boss"):
            continue

        enemy["shoot_timer"] -= dt
        if enemy["shoot_timer"] <= 0:
            dx = player.rect.centerx - enemy["rect"].centerx
            dy = player.rect.centery - enemy["rect"].centery
            distance = max(1.0, math.hypot(dx, dy))
            speed = 220.0 if behavior == "cave_boss" else 190.0
            spread = (-0.22, 0.0, 0.22) if behavior == "cave_boss" else (0.0,)
            aim_angle = math.atan2(dy, dx)
            for offset in spread:
                angle = aim_angle + offset
                projectiles.append({
                    "team": "enemy",
                    "rect": pygame.Rect(enemy["rect"].centerx - 7, enemy["rect"].centery - 7, 14, 14),
                    "vx": math.cos(angle) * speed,
                    "vy": math.sin(angle) * speed,
                    "source_x": enemy["rect"].centerx,
                    "damage": 1,
                    "life": 4.5,
                })
            enemy["shoot_timer"] = enemy["shoot_cooldown"]

    for projectile in projectiles[:]:
        rect = projectile["rect"]
        rect.x += round(projectile["vx"] * dt)
        rect.y += round(projectile["vy"] * dt)
        projectile["life"] -= dt
        if projectile["team"] == "player":
            hit_enemy = next((enemy for enemy in enemies if rect.colliderect(enemy["rect"])), None)
            if hit_enemy:
                hit_enemy["health"] -= projectile["damage"]
                hit_enemy["hit_timer"] = 0.16
                if hit_enemy["health"] <= 0:
                    spawn_food_drop(hit_enemy, food_drops)
                    enemies.remove(hit_enemy)
                projectiles.remove(projectile)
                continue
        blocked_by_terrain = any(rect.colliderect(solid) for solid in solids)
        if projectile["life"] <= 0 or not pygame.Rect(0, 0, WIDTH, HEIGHT).colliderect(rect) or blocked_by_terrain:
            projectiles.remove(projectile)


