def load_keyed_sheet(filename, tolerance=18, key_position=(0, 0)):
    sheet = pygame.image.load(str(ASSET_DIR / filename)).convert()
    key = sheet.get_at(key_position)[:3]
    mapped_key = sheet.map_rgb(key)
    pixels = pygame.PixelArray(sheet)
    for y in range(sheet.get_height()):
        for x in range(sheet.get_width()):
            color = sheet.unmap_rgb(pixels[x, y])
            if max(abs(color[index] - key[index]) for index in range(3)) <= tolerance:
                pixels[x, y] = mapped_key
    del pixels
    sheet.set_colorkey(key)
    return sheet


def crop_sprite(sheet, bounds):
    sprite = sheet.subsurface(pygame.Rect(bounds)).copy()
    sprite.set_colorkey(sheet.get_colorkey())
    return sprite


_scale_cache = {}


def scale_sprite(sprite, size):
    cache_key = (id(sprite), size)
    if cache_key not in _scale_cache:
        scaled = pygame.transform.scale(sprite, size)
        if sprite.get_colorkey() is not None:
            scaled.set_colorkey(sprite.get_colorkey())
        _scale_cache[cache_key] = scaled
    return _scale_cache[cache_key]


