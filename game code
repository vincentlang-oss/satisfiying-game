            "rect": pygame.Rect(spec["rect"]),
            "left": spec["left"],
            "right": spec["right"],
            "speed": spec["speed"],
            "base_y": spec["rect"][1],
            "amplitude": spec["amplitude"],
            "phase": 0.0,
            "health": spec["health"],
            "max_health": spec["health"],
            "hit_timer": 0.0,
            "shoot_cooldown": spec.get("shoot_cooldown", 1.8),
            "shoot_timer": spec.get("shoot_cooldown", 1.8),
        })

    objects = [
        {"kind": item["kind"], "rect": pygame.Rect(item["rect"])}
        for item in level["objects"]
    ]
    hazards = [pygame.Rect(item) for item in level["hazards"]]
