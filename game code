def draw_vines(vines, attached, swing_anchor, swing_angle):
    for anchor in vines:
        if attached and anchor == swing_anchor:
            end_x = anchor[0] + math.sin(swing_angle) * 135
            end_y = anchor[1] + math.cos(swing_angle) * 135
        else:
            end_x = anchor[0] + 8
            end_y = anchor[1] + 100

        pygame.draw.line(
            screen, (45, 105, 45),
            anchor, (round(end_x), round(end_y)), 5,
        )
        pygame.draw.circle(screen, (35, 125, 55), anchor, 8)


