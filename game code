def level_picker_layout(beaten_levels):
    levels = sorted(beaten_levels)
    rows = max(1, (len(levels) + 4) // 5)
    panel = pygame.Rect(WIDTH - 286, 96, 274, 48 + rows * 34)
    buttons = []
    for index, number in enumerate(levels):
        row, column = divmod(index, 5)
        rect = pygame.Rect(panel.x + 12 + column * 48, panel.y + 38 + row * 34, 42, 28)
        buttons.append((number, rect))
    return panel, buttons


def draw_level_picker(beaten_levels, current_level):
