def advance_or_restart():
    global level_index, player, enemies, objects, hazards, weapon_pickup, projectiles
    global weapon, attack_timer, attack_effect_timer, attack_rect, health, damage_timer, game_state, selected_mode
    global bow_unlocked, bow_shoot_timer, beaten_levels, level_menu_open
    global food_drops, food_score, food_fact, food_fact_timer

    if game_state == "level_complete":
        beaten_levels.add(LEVELS[level_index]["number"])
        level_menu_open = False
        if level_index < len(LEVELS) - 1:
            level_index += 1
            player, enemies, objects, hazards, weapon_pickup, health, damage_timer = load_level(level_index)
            projectiles = []
            food_drops = []
            attack_timer = 0.0
            attack_effect_timer = 0.0
            attack_rect = None
            game_state = "playing"
        else:
            game_state = "game_complete"

    elif game_state in ("game_complete", "game_over"):
        if game_state == "game_complete":
            LEVELS[:] = generate_hard_campaign() if selected_mode == "hard" else generate_campaign()
            level_index = 0
            weapon = {"name": "Broccoli Club", "damage": 1, "range": 44}
            bow_unlocked = False
            bow_shoot_timer = 0.0
            beaten_levels = set()
            level_menu_open = False
            food_drops = []
            food_score = 0
            food_fact = ""
            food_fact_timer = 0.0
        player, enemies, objects, hazards, weapon_pickup, health, damage_timer = load_level(level_index)
        projectiles = []
        food_drops = []
        attack_timer = 0.0
        attack_effect_timer = 0.0
        attack_rect = None
        game_state = "playing"


level_index = 0
player, enemies, objects, hazards, weapon_pickup, health, damage_timer = load_level(level_index)
weapon = {"name": "Broccoli Club", "damage": 1, "range": 44}
bow_unlocked = False
bow_shoot_timer = 0.0
projectiles = []
food_drops = []
food_score = 0
food_fact = ""
food_fact_timer = 0.0
attack_timer = 0.0
attack_effect_timer = 0.0
attack_rect = None
selected_mode = None
beaten_levels = set()
level_menu_open = False
game_state = "mode_select"
running = True

while running:
    dt = min(clock.tick(60) / 1000.0, 1 / 30)
    attack_timer = max(0.0, attack_timer - dt)
    attack_effect_timer = max(0.0, attack_effect_timer - dt)
    bow_shoot_timer = max(0.0, bow_shoot_timer - dt)
    food_fact_timer = max(0.0, food_fact_timer - dt)
    level = LEVELS[level_index]
    if level["number"] >= 10:
        bow_unlocked = True
    platforms = [pygame.Rect(item) for item in level["platforms"]]
    goal = pygame.Rect(level["goal"])
    keys = pygame.key.get_pressed()

    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False

        elif event.type == pygame.KEYDOWN:
            if game_state == "mode_select":
                if event.key in (pygame.K_1, pygame.K_KP1):
                    start_mode("normal")
                elif event.key in (pygame.K_2, pygame.K_KP2):
                    start_mode("hard")
            elif game_state == "playing":
                if event.key == pygame.K_ESCAPE and level_menu_open:
                    level_menu_open = False
                elif level_menu_open:
                    pass
                elif event.key == pygame.K_e:
                    player.toggle_vine(level["vines"])
                elif event.key == pygame.K_f and attack_timer == 0:
                    attack_rect = perform_attack(player, enemies, weapon, food_drops)
                    attack_timer = 0.32
                    attack_effect_timer = 0.12
                elif event.key == pygame.K_g and bow_unlocked and bow_shoot_timer == 0:
                    shoot_arrow(player, projectiles)
                    bow_shoot_timer = 0.35
            elif game_state in ("level_complete", "game_complete", "game_over"):
                if event.key in (pygame.K_RETURN, pygame.K_SPACE):
                    advance_or_restart()

        elif event.type == pygame.MOUSEBUTTONDOWN and event.button == 1:
            if game_state == "mode_select":
                if normal_button_rect.collidepoint(event.pos):
                    start_mode("normal")
                elif hard_button_rect.collidepoint(event.pos):
                    start_mode("hard")
            elif game_state in ("level_complete", "game_complete", "game_over"):
                if button_rect.collidepoint(event.pos):
                    advance_or_restart()
            elif game_state == "playing" and beaten_levels:
                if level_menu_button_rect.collidepoint(event.pos):
                    level_menu_open = not level_menu_open
                elif level_menu_open:
                    panel, buttons = level_picker_layout(beaten_levels)
                    selected_level = next((number for number, rect in buttons if rect.collidepoint(event.pos)), None)
                    if selected_level is not None:
                        select_cleared_level(selected_level)
                    elif not panel.collidepoint(event.pos):
                        level_menu_open = False

    if game_state == "mode_select":
        draw_mode_menu()
        pygame.display.flip()
        continue

    if game_state == "playing" and not level_menu_open:
        collision_solids = platforms + [item["rect"] for item in objects]
        player.update(dt, keys, collision_solids, level["theme"])

        if weapon_pickup and player.rect.colliderect(weapon_pickup["rect"]):
            weapon = {key: value for key, value in weapon_pickup.items() if key != "rect"}
            weapon_pickup = None

        frame = dt * 60
        update_enemies(enemies, frame, dt)
        update_projectiles(enemies, projectiles, player, dt, collision_solids, food_drops)

        for drop in food_drops:
            drop["bob"] += dt * 4
        collected_food = collect_food_drop(player, food_drops)
        if collected_food:
            food_score += 1
            health = min(3, health + 1)
            food_fact = FOOD_FACTS[collected_food]
            food_fact_timer = 5.0

        damage_timer = max(0.0, damage_timer - dt)

        # Falling costs one health and returns the player to the start.
        if player.rect.top > HEIGHT + 80 and damage_timer == 0:
            health -= 1
            damage_timer = 1.0

            if health <= 0:
                game_state = "game_over"
            else:
                player.respawn(level["start"])

        # A forward guard blocks enemy contact and projectiles, but not terrain hazards.
        if damage_timer == 0:
            for projectile in projectiles[:]:
                if player.rect.colliderect(projectile["rect"]):
                    incoming_direction = 1 if projectile["source_x"] > player.rect.centerx else -1
                    projectiles.remove(projectile)
                    if player.blocking and player.facing == incoming_direction:
                        continue
                    health -= 1
                    damage_timer = 1.0
                    if health <= 0:
                        game_state = "game_over"
                    break

        if damage_timer == 0:
            for enemy in enemies:
                if player.rect.colliderect(enemy["rect"]):
                    incoming_direction = 1 if enemy["rect"].centerx > player.rect.centerx else -1
                    if player.blocking and player.facing == incoming_direction:
                        break
                    health -= 1
                    damage_timer = 1.0
                    player.attached = False
                    player.swing_anchor = None
                    player.vx = -5 if incoming_direction > 0 else 5
                    player.vy = -7
                    player.on_ground = False
                    if health <= 0:
                        game_state = "game_over"
                    break

        if damage_timer == 0:
            for hazard in hazards:
                if player.rect.colliderect(hazard):
                    health -= 1
                    damage_timer = 1.0
                    player.vx = -5 if player.rect.centerx < hazard.centerx else 5
                    player.vy = -7
                    player.on_ground = False
                    if health <= 0:
                        game_state = "game_over"
                    break

        boss_alive = any(enemy.get("behavior", enemy["kind"]) in ("boss", "cave_boss") for enemy in enemies)
        must_clear_enemies = level.get("kill_required", False) and enemies
        if game_state == "playing" and not boss_alive and not must_clear_enemies and player.rect.colliderect(goal):
            beaten_levels.add(level["number"])
            game_state = "level_complete"

    # Draw the level.
    draw_background(level["theme"], level)
    draw_platforms(platforms, level["theme"])
    draw_objects(objects)
    draw_food_drops(food_drops)
    draw_hazards(hazards, level["theme"])
    draw_vines(
        level["vines"],
        player.attached,
        player.swing_anchor,
        player.swing_angle,
    )
    draw_enemies(enemies)
    draw_projectiles(projectiles)

    draw_goal(goal, level["theme"])
    if weapon_pickup:
        draw_weapon_pickup(weapon_pickup)

    if damage_timer == 0 or int(damage_timer * 10) % 2 == 0:
        draw_player(player, level["theme"], weapon, bow_unlocked)
    if attack_effect_timer > 0 and attack_rect:
        draw_attack_effect(attack_rect, level["theme"])

    ui_color = WHITE if level["theme"] in ("lava", "cave") else DARK
    screen.blit(
        font.render(f"Level {level_index + 1}: {level['name']}", True, ui_color),
        (18, 16),
    )
    feature_text = small_font.render(f"New: {level['feature']}", True, ui_color)
    screen.blit(feature_text, (WIDTH - feature_text.get_width() - 18, 18))

    controls = "W/A/S/D: Move/Jump/Drop   F: Broccoli swing   Shift: Block"
    if level["theme"] == "jungle":
        controls += "   E: Vine"
    elif level["theme"] == "snow":
        controls += "   Ice is slippery"
    elif level["theme"] == "cave":
        controls += "   Cave sentries fire bolts"
    else:
        controls += "   Dodge lava"
    screen.blit(small_font.render(controls, True, ui_color), (18, 48))
    draw_health(health, ui_color)
    weapon_name = weapon["name"] if weapon else "Fists"
    screen.blit(small_font.render(f"Weapon: {weapon_name}", True, ui_color), (18, 108))
    screen.blit(small_font.render(f"Healthy foods found: {food_score}", True, ui_color), (18, 130))
    bow_status = "Bow: G to shoot" if bow_unlocked else "Bow unlocks at level 10"
    screen.blit(small_font.render(bow_status, True, ui_color), (18, 152))
    if level.get("kill_required", False) and enemies:
        clear_text = small_font.render(f"Clear enemies: {len(enemies)} left", True, ui_color)
        screen.blit(clear_text, (18, 174))
    if food_fact_timer > 0 and food_fact:
        fact_surface = small_font.render(food_fact, True, WHITE)
        fact_panel = pygame.Surface((WIDTH - 24, 34), pygame.SRCALPHA)
        fact_panel.fill((22, 38, 42, 215))
        screen.blit(fact_panel, (12, HEIGHT - 44))
        screen.blit(fact_surface, (22, HEIGHT - 35))
    if game_state == "playing" and beaten_levels:
        hovered = level_menu_button_rect.collidepoint(pygame.mouse.get_pos())
        pygame.draw.rect(screen, (71, 105, 89) if not hovered else (91, 139, 111), level_menu_button_rect, border_radius=4)
        pygame.draw.rect(screen, WHITE, level_menu_button_rect, 1, border_radius=4)
        menu_label = small_font.render("Levels", True, WHITE)
        screen.blit(menu_label, menu_label.get_rect(center=level_menu_button_rect.center))
        if level_menu_open:
            draw_level_picker(beaten_levels, level["number"])
    if any(enemy.get("behavior", enemy["kind"]) in ("boss", "cave_boss") for enemy in enemies):
        boss_hint = small_font.render("Defeat the Titan to unlock the gate", True, WHITE)
        screen.blit(boss_hint, boss_hint.get_rect(center=(WIDTH // 2, 82)))

    # Completion and retry screens.
    if game_state in ("level_complete", "game_complete", "game_over"):
        overlay = pygame.Surface((WIDTH, HEIGHT), pygame.SRCALPHA)
        overlay.fill((10, 25, 35, 165))
        screen.blit(overlay, (0, 0))

        if game_state == "level_complete":
            title = "Level Complete!"
            label = "Next Level" if level_index < len(LEVELS) - 1 else "Finish Game"
        elif game_state == "game_complete":
            title = "You Completed the Game!"
            label = "Play Again"
        else:
            title = "Game Over"
            label = "Retry Level"

        title_surface = big_font.render(title, True, WHITE)
        screen.blit(
            title_surface,
            title_surface.get_rect(center=(WIDTH // 2, HEIGHT // 2 - 35)),
        )

        draw_button(
            button_rect,
            label,
            button_rect.collidepoint(pygame.mouse.get_pos()),
        )

        hint = small_font.render("Click the button or press Enter", True, WHITE)
        screen.blit(
            hint,
            hint.get_rect(center=(WIDTH // 2, HEIGHT // 2 + 120)),
        )

    pygame.display.flip()

pygame.quit()
