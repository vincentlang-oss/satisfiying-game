    behavior = enemy.get("behavior", enemy["kind"])
    kind = FOOD_REWARDS.get(behavior, "apple")
    rect = enemy["rect"]
    food_drops.append({
        "kind": kind,
        "rect": pygame.Rect(rect.centerx - 11, rect.top - 22, 22, 22),
        "bob": 0.0,
    })


def collect_food_drop(player, food_drops):
    for drop in food_drops:
        if player.rect.colliderect(drop["rect"]):
            food_drops.remove(drop)
            return drop["kind"]
    return None


def perform_attack(player, enemies, weapon, food_drops):
    damage = weapon["damage"] if weapon else 1
    reach = weapon["range"] if weapon else 44
    attack_y = player.rect.y + 12
    attack_x = player.rect.right - 4 if player.facing > 0 else player.rect.left - reach + 4
    attack_rect = pygame.Rect(attack_x, attack_y, reach, 28)

    for enemy in enemies[:]:
        if attack_rect.colliderect(enemy["rect"]):
            enemy["health"] -= damage
            enemy["hit_timer"] = 0.16
            if enemy["health"] <= 0:
                spawn_food_drop(enemy, food_drops)
                enemies.remove(enemy)

    return attack_rect


