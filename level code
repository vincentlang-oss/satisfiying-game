def _object(kind, rect):
    return {"kind": kind, "rect": rect}


def _enemy(kind, rect, left, right, speed, amplitude=0, health=1, shoot_cooldown=None):
    enemy = {
        "kind": kind,
        "rect": rect,
        "left": left,
        "right": right,
        "speed": speed,
        "amplitude": amplitude,
        "health": health,
    }
    if shoot_cooldown is not None:
        enemy["shoot_cooldown"] = shoot_cooldown
    return enemy


def _level(number, name, theme, feature, platforms, objects=(), hazards=(), enemies=(), vines=(), start=(40, 452), weapon_pickup=None, kill_required=False):
    raised_platforms = tuple(
        (x, 420 if y >= 460 and width <= 80 and height <= 40 else y, width, height)
        for x, y, width, height in platforms
    )
    raised_objects = []
    for item in objects:
        x, y, width, height = item["rect"]
        if y + height > 450:
            y = min(y, 420 - height)
        raised_objects.append(_object(item["kind"], (x, y, width, height)))
    raised_hazards = tuple(
        (x, 420 if y >= 460 else y, width, height)
        for x, y, width, height in hazards
    )
    return {
        "number": number,
        "name": name,
        "theme": theme,
        "feature": feature,
        "difficulty": number,
        "start": start,
        "goal": (835, 435, 40, 65),
        "platforms": raised_platforms,
        "objects": raised_objects,
        "hazards": list(raised_hazards),
        "vines": list(vines),
        "enemies": list(enemies),
        "weapon_pickup": weapon_pickup,
        "kill_required": kill_required,
    }


